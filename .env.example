# Use either SerpAPI or Google Custom Search for Google Images.
SERPAPI_KEY=

# Alternative to SerpAPI:
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Optional distributor domains, comma-separated.
# Example: distributor-one.com,distributor-two.com
DISTRIBUTOR_DOMAINS=

# Supabase database update.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=products
SUPABASE_MATCH_COLUMN=product_name

# Optional. If set, the script downloads the selected image and uploads it
# to Supabase Storage, then stores the public storage URL in the product row.
# If empty, the script stores the original selected image URL.
SUPABASE_STORAGE_BUCKET=product-images
